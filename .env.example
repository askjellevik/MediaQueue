# Copy to .env and fill in. See docs/SPEC.md "Operations" for details.
# .env is read by `docker compose`; the app itself only reads process env vars.

# --- Phase 0: required ---

# Public URL the app is served at. Must be https:// unless COOKIE_DEV_INSECURE=1.
PUBLIC_ORIGIN=https://requests.example.com

# Address the app binds inside its container/process. Default: 0.0.0.0:8000
BIND_ADDR=0.0.0.0:8000

# Path to the SQLite database file. The parent directory is created if missing.
DATABASE_PATH=/data/db.sqlite3

# HMAC key for hashing access codes. Must be at least 32 random bytes.
# Generate one with: openssl rand -base64 48
CODE_PEPPER=

# Set to 1 only for local development over plain http. Refuses to start
# if PUBLIC_ORIGIN is https while this is set.
COOKIE_DEV_INSECURE=0

# Log level/filter for tracing's EnvFilter, e.g. info, debug, warn.
RUST_LOG=info
