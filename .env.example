# Copy to .env and fill in. See docs/SPEC.md "Operations" for details.
# .env is read by `docker compose`; the app itself only reads process env vars.

# --- Phase 0: required ---

# Public URL the app is served at. Must be https:// unless COOKIE_DEV_INSECURE=1.
PUBLIC_ORIGIN=https://requests.example.com

# Address the app binds inside its container/process. Default: 0.0.0.0:8000
BIND_ADDR=0.0.0.0:8000

# Path to the SQLite database file. The parent directory is created if missing.
DATABASE_PATH=/data/db.sqlite3

# HMAC key for hashing access codes. Must be at least 32 random bytes.
# Generate one with: openssl rand -base64 48
CODE_PEPPER=

# Set to 1 only for local development over plain http. Refuses to start
# if PUBLIC_ORIGIN is https while this is set.
COOKIE_DEV_INSECURE=0

# Log level/filter for tracing's EnvFilter, e.g. info, debug, warn.
RUST_LOG=info

# --- Phase 1: required ---

# Admin username and Argon2id PHC hash of the admin password. Generate the
# hash with: media-requests hash-password
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# --- Phase 3: required ---

# TMDB "API Read Access Token" (v4 auth), sent as a bearer token. Create one
# at https://www.themoviedb.org/settings/api.
TMDB_TOKEN=

# TMDB API base URL. Only change this to point tests at a mock server.
TMDB_BASE_URL=https://api.themoviedb.org/3

# --- Phase 1: optional, sensible defaults ---

# Access code length in characters. Minimum and default is 8; the app
# refuses to start with a shorter value.
CODE_LENGTH=8

# Default per-member device/session cap and daily request quota, used
# unless a member has its own override.
DEFAULT_MAX_SESSIONS=3
DEFAULT_DAILY_LIMIT=10

# CIDRs (comma-separated) whose TCP peer address is trusted to supply
# X-Real-IP; everything else's X-Real-IP header is ignored. Default is
# loopback plus the Docker bridge range.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12

# --- Phase 2: push notifications (optional) ---

# ntfy server; leave empty to turn notifications off. On public ntfy.sh
# anyone who knows the topic can read it, so use a long random topic, or
# self-host ntfy and set NTFY_TOKEN. The topic may only contain letters,
# digits, '-' and '_'.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# --- Phase 2: rate limits (optional, defaults shown) ---

# Every /api call, per client IP (IPv6 keyed by /64).
RL_API_PER_MINUTE=120

# Search, per member: burst size and refill per second.
RL_SEARCH_BURST=10
RL_SEARCH_PER_SECOND=5

# Outbound TMDB calls per second, across all users. Beyond it the cache
# serves stale results, or the search fails with 503.
RL_TMDB_PER_SECOND=20

# Request submissions (new or duplicate) per member per minute. The daily
# cap is DEFAULT_DAILY_LIMIT unless the member has an override.
RL_REQUESTS_PER_MINUTE=3

# Most keys any one limiter tracks. New keys beyond it are limited
# (fail closed), so memory stays bounded under attack.
RL_KEY_CAP=10000

# Wrong access codes / admin logins per IP: RL_FAIL_MAX failures within
# RL_FAIL_WINDOW_SECS locks that IP out. Each further lockout uses the next
# entry of RL_LOCKOUT_SECS (15 min, 1 h, 24 h); the level resets after the
# longest lockout passes with no failures.
RL_FAIL_MAX=5
RL_FAIL_WINDOW_SECS=900
RL_LOCKOUT_SECS=900,3600,86400

# Global throttle on wrong access codes: above TIER1 failures within the
# window every attempt is delayed RL_THROTTLE_DELAY1_MS, above TIER2 by
# RL_THROTTLE_DELAY2_MS. A correct code still logs in, just slower.
RL_CODE_THROTTLE_WINDOW_SECS=3600
RL_CODE_THROTTLE_TIER1=60
RL_CODE_THROTTLE_TIER2=300

# The same global throttle for wrong admin logins.
RL_ADMIN_THROTTLE_WINDOW_SECS=900
RL_ADMIN_THROTTLE_TIER1=30
RL_ADMIN_THROTTLE_TIER2=150

RL_THROTTLE_DELAY1_MS=1000
RL_THROTTLE_DELAY2_MS=3000

# Attempts that may wait out a throttle delay at once (per throttle);
# beyond this the response is 429 with Retry-After.
RL_DELAY_PERMITS=32

# Minimum seconds between two "throttle on/off" ntfy alerts.
RL_ALERT_INTERVAL_SECS=3600
