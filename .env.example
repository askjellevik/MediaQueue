# Copy to .env and fill in. `docker compose` reads this file.

# --- Required ---

# The exact address people type in the browser, including a non-default port.
# No trailing slash or path. Use https:// except for local development.
PUBLIC_ORIGIN=https://requests.example.com
# At least 32 random bytes: openssl rand -base64 48
# Compose also hands it to the worker service.
CODE_PEPPER=
# Admin login. Hash the password with: mediaqueue hash-password
# Keep the single quotes: Docker Compose expands $ in env files.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=''
# TMDB "API Read Access Token": https://www.themoviedb.org/settings/api
TMDB_TOKEN=

# --- Notifications (optional) ---

# ntfy alerts for new requests; leave NTFY_URL empty for none. Use a long
# random topic (letters, digits, '-', '_') or self-host and set NTFY_TOKEN.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# --- Cloudflare Access (optional) ---

# Needs an image built with `--features cf-access`.
CF_ACCESS_ENABLED=0
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# CF_ACCESS_CERTS_URL=

# --- Fetch worker (optional) ---

# Listener for the worker, separate from the public port. Both or neither.
# Under compose it is set in compose.yaml to 0.0.0.0:8001 on the dedicated
# network; set it here only for cargo run (keep 127.0.0.1:8001).
# INTERNAL_LISTEN=127.0.0.1:8001
# At least 32 random bytes: openssl rand -base64 48
# Compose also hands it to the worker service.
# INTERNAL_TOKEN=
# Pin the kill switch and mode (the admin toggle then cannot change them).
# WORKER_ENABLED=false
# WORKER_MODE=dry_run
# Daily caps of the worker, read by the worker service through compose. They
# apply only to torrents the worker chose itself (auto jobs). A torrent a
# human picked is never counted against them or stopped by them; it is only
# counted in a statistic that is logged. The breaker, the per-minute request
# budget and the kill switch apply to everything.
# WORKER_MAX_ADDS_PER_DAY=5
# WORKER_MAX_UNCACHED_PER_DAY=2
# Refusals (Real-Debrid error 35) are refunded from the adds and counted here;
# a day with this many idles auto jobs only.
# WORKER_MAX_REFUSALS_PER_DAY=20
# Release groups (comma separated, case-insensitive) that earn a bonus in the
# ranking of Infuse PRO jobs only; free jobs ignore it. Empty switches the
# bonus off. Read by the worker service through compose.
# WORKER_PRO_GROUPS=framestor
# Automatic jobs one opted-in member may get per UTC day, read by the portal's
# auto sweep (the worker's caps above are the global limit). 0 switches the
# sweep off.
# AUTO_FETCH_PER_MEMBER_DAY=3
# Never put the Real-Debrid token in this file: the portal reads it and
# refuses to start if RD_TOKEN or RD_TOKEN_FILE is set.

# --- Advanced (optional) ---

# RUST_LOG=info
# Proxies trusted to send X-Real-IP (comma-separated CIDRs).
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
